{
	"name": "@coresmos/trivium",
	"productName": "Trivium",
	"version": "0.4.0",
	"private": true,
	"description": "Desktop workspace for coding, research and writing, built on the pi SDK",
	"license": "MIT",
	"keywords": [
		"ai-agent",
		"coding-agent",
		"desktop-app",
		"electron",
		"pi",
		"llm",
		"research-assistant",
		"writing-assistant"
	],
	"homepage": "https://github.com/SkarnerV/Trivium#readme",
	"bugs": {
		"url": "https://github.com/SkarnerV/Trivium/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SkarnerV/Trivium.git"
	},
	"type": "module",
	"main": "dist/main.mjs",
	"scripts": {
		"build": "node scripts/build.mjs",
		"package": "node scripts/build.mjs --production && electron-builder",
		"test": "node --experimental-strip-types --test scripts/*.test.ts scripts/*.test.mjs",
		"start": "node scripts/build.mjs && node scripts/start.mjs",
		"dev": "node scripts/dev.mjs",
		"check": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@narumitw/pi-plan-mode": "0.59.4",
		"@pify/memory": "0.14.0",
		"diff": "8.0.4",
		"pi-docparser": "4.0.0",
		"pi-markdown-preview": "0.24.0",
		"pi-subagents": "0.82.1"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"electron": "45.0.0",
		"electron-builder": "26.18.0",
		"esbuild": "0.28.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"resedit": "3.1.0",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
